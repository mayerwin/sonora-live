{
  "name": "sonora-live",
  "version": "1.0.0",
  "private": true,
  "description": "Remote music lessons in the browser: peer-to-peer video with pure, unprocessed instrument sound and two-way MIDI between teacher and student pianos.",
  "type": "module",
  "license": "MIT",
  "homepage": "https://mayerwin.github.io/sonora-live/",
  "repository": {
    "type": "git",
    "url": "https://github.com/mayerwin/sonora-live.git"
  },
  "keywords": [
    "webrtc",
    "webmidi",
    "music-education",
    "low-latency-audio",
    "p2p",
    "piano",
    "remote-teaching",
    "opus-audio"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p .",
    "test": "vitest run",
    "e2e": "playwright test",
    "icons": "node tools/icons.ts",
    "check": "npm run typecheck && npm test && npm run build"
  },
  "engines": {
    "node": ">=22.18"
  },
  "dependencies": {
    "@fontsource-variable/instrument-sans": "5.3.0",
    "@fontsource/instrument-serif": "5.3.0",
    "@preact/signals": "2.11.4",
    "emoji-picker-element": "1.29.1",
    "linkifyjs": "4.4.0",
    "lucide-preact": "1.64.0",
    "preact": "11.1.0",
    "uqr": "0.1.3",
    "workbox-window": "7.4.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.5",
    "@types/ws": "8.18.1",
    "emoji-picker-element-data": "1.8.0",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vite-plugin-pwa": "2.0.0",
    "vitest": "5.0.5",
    "ws": "8.22.0"
  }
}
